# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring. .env git'ga tushmaydi.
# Ishga tushirish: node --env-file=.env server.mjs   (Node.js 20.6+)

# Claude API kaliti (https://console.anthropic.com). Bo'sh bo'lsa AI tahlil o'chiq, qolgan hamma narsa ishlaydi.
ANTHROPIC_API_KEY=

# Telegram bot tokeni (@BotFather dan). Faqat bot.mjs uchun kerak.
TELEGRAM_BOT_TOKEN=

# Ixtiyoriy
PORT=3000
# IQ_AI_TIMEOUT_MS=45000
# IQ_AI_RETRIES=2
