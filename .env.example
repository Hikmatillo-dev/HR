# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring. .env git'ga tushmaydi.
# Ishga tushirish: npm start  (.env avtomatik o'qiladi, Node.js 20.12+; eski versiyada: npm run start:env)

# AI chuqur tahlil (ixtiyoriy). Kalit bo'lmasa AI o'chiq, qolgan hamma narsa ishlaydi. Bittasini to'ldiring:
# Claude API kaliti (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# yoki Google Gemini kaliti (https://aistudio.google.com → Get API key; bepul limit bor).
# Bepul rejimda Google yuborilgan matnni o'z xizmatlarini yaxshilash uchun ishlatishi mumkin.
GEMINI_API_KEY=
# Ikkala kalit bo'lsa Claude ishlatiladi. Aniq tanlash: IQ_AI_PROVIDER=gemini (yoki anthropic)
# IQ_AI_PROVIDER=gemini
# Gemini modeli. Sukut: gemini-flash-latest (Google o'zi eng yangi Flash modelga yo'naltiradi)
# IQ_GEMINI_MODEL=gemini-flash-latest

# Telegram bot tokeni (@BotFather dan). Faqat bot.mjs uchun kerak.
TELEGRAM_BOT_TOKEN=
# /stats uchun user_id SHA-256(tuz + ":" + id) qilib saqlanadi. Bo'sh qolsa, data/bot-salt avtomatik yaratiladi.
# Tuzni o'zgartirsangiz eski statistika yangi foydalanuvchiga bog'lanmay qoladi. Yaratish: openssl rand -hex 32
IQ_BOT_HASH_SALT=

# Valyuta kurslari (so'm). Sana bilan berilsa va 30 kundan eski bo'lmasa, UI'da "Kurslar taxminiy" belgisi chiqmaydi.
# IQ_RATE_USD=12600
# IQ_RATE_EUR=13700
# IQ_RATE_RUB=150
# IQ_RATES_UPDATED=2026-10-11
# IQ_RATES_SOURCE="O'zbekiston Respublikasi Markaziy banki, 2026-10-11"

# ---------- Xavfsizlik va limitlar ----------
# Server qaysi manzilda tinglaydi. Sukut: 127.0.0.1 (faqat shu kompyuter). Tarmoqqa ochish: HOST=0.0.0.0
HOST=127.0.0.1
# AI tahlil kunlik limiti (server va bot uchun alohida hisoblanadi). 0 — AI o'chiq. Sukut: 200
IQ_AI_DAILY_LIMIT=200
# Bir IP dan daqiqasiga AI so'rovlari (server). Sukut: 10
# IQ_AI_PER_MINUTE=10
# Botda bitta foydalanuvchiga soatiga AI tahlil. Sukut: 5
# IQ_BOT_AI_PER_HOUR=5
# Proksi (nginx, Cloudflare) orqasida: ishonchli proksilar soni. Faqat shunda X-Forwarded-For o'qiladi. Sukut: 0
# IQ_TRUST_PROXY=1
# Sahifa boshqa domendan ochilsa, ruxsat etilgan Origin'lar (vergul bilan)
# IQ_ALLOWED_ORIGINS=https://ishqalqon.example
# Limit hisoblari va bot statistikasi papkasi. Sukut: ./data
# IQ_DATA_DIR=./data

# Ixtiyoriy
PORT=3000
# IQ_AI_TIMEOUT_MS=45000
# IQ_AI_RETRIES=2
